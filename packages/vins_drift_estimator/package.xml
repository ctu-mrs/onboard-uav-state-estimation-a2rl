<?xml version="1.0"?>
<package format="2">

  <name>vins_drift_estimator</name>
  <version>1.0.0</version>
  <description>The VINS Drift Estimator package</description>

  <author email="filip.novak@fel.cvut.cz">Filip Novak</author>
